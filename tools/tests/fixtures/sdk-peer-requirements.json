{
  "abitype": {
    "package": "abitype",
    "version": "1.3.0",
    "source": "https://registry.npmjs.org/abitype/1.3.0",
    "requirements": {
      "typescript": {
        "constraint": ">=5.0.4",
        "optional": true
      },
      "zod": {
        "constraint": "^3.22.0 || ^4.0.0",
        "optional": true
      }
    }
  },
  "synapse-react": {
    "package": "@filoz/synapse-react",
    "version": "0.5.0",
    "source": "https://registry.npmjs.org/%40filoz%2Fsynapse-react/0.5.0",
    "requirements": {
      "@tanstack/react-query": {
        "constraint": "5.x",
        "optional": false
      },
      "@wagmi/core": {
        "constraint": "3.x",
        "optional": false
      },
      "viem": {
        "constraint": "2.x",
        "optional": false
      },
      "wagmi": {
        "constraint": "3.x",
        "optional": false
      }
    }
  }
